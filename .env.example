# Copy to .env and fill in real values. Never commit .env itself.

# Admin password hash (bcrypt). Generate with:
#   php -r 'echo password_hash("your-password", PASSWORD_DEFAULT), "\n";'
ADMIN_PASSWORD_HASH=

# Secret used to salt hashed IPs. Generate with:
#   php -r 'echo bin2hex(random_bytes(32)), "\n";'
APP_SECRET=

# production | development  (development shows PHP errors)
APP_ENV=production

# Canonical browser origin. Production requires HTTPS.
APP_ORIGIN=https://php.micutu.com

# Optional absolute storage path. It must remain outside the web root.
# APP_STORAGE_DIR=/srv/canary/php.micutu.com/php_micutu_app_storage
