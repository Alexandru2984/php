# Non-secret routing for php-guestbook-offsite.service. The rclone credential is
# supplied separately through LoadCredentialEncrypted and never belongs here.
# Put the currently healthy destination first so a degraded secondary cannot delay
# the first recoverable copy. Every configured destination is still attempted.
OFFSITE_REMOTES=r2:micutu-vps-backup/php-guestbook gdrive:Backup_VPS/php-guestbook
OFFSITE_TRANSFERS=2

# SHA-256 of /etc/php-guestbook/backup-recipients. Pinning the public recipients
# file turns an unnoticed key replacement into a failed backup and pager alert.
OFFSITE_RECIPIENTS_SHA256=replace-with-64-lowercase-hex-characters
