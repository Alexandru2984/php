[Unit]
Description=PHP guestbook production health, security and recovery probe
After=network-online.target nginx.service php8.5-fpm.service php-guestbook-backup.service php-guestbook-offsite.service
Wants=network-online.target
ConditionFileIsExecutable=/srv/canary/php.micutu.com/current/scripts/healthcheck.sh
OnFailure=swift-vapor-alert@%n.service
OnSuccess=swift-vapor-resolved@%n.service

[Service]
Type=oneshot
User=php-guestbook
Group=php-guestbook
UMask=0077
Environment=GUESTBOOK_ANALYTICS_WEBSITE_ID=c4e3a772-26b3-47e7-afec-b82097684551
ExecStart=/usr/bin/bash /srv/canary/php.micutu.com/current/scripts/healthcheck.sh
TimeoutStartSec=45

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=yes
# SQLite WAL readers may need to open/create WAL and SHM sidecars.
ReadWritePaths=/srv/canary/php.micutu.com/php_micutu_app_storage
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
InaccessiblePaths=-/run/docker.sock -/run/containerd/containerd.sock -/run/podman/podman.sock
LimitCORE=0
LimitNOFILE=256
TasksMax=32
MemoryMax=128M
CPUQuota=100%
Nice=10
