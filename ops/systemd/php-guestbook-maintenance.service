[Unit]
Description=Prune and optimize the PHP guestbook database
After=local-fs.target
OnFailure=swift-vapor-alert@%n.service
OnSuccess=swift-vapor-resolved@%n.service

[Service]
Type=oneshot
User=php-guestbook
Group=php-guestbook
UMask=0077
WorkingDirectory=/srv/canary/php.micutu.com/current
Environment=APP_STORAGE_DIR=/srv/canary/php.micutu.com/php_micutu_app_storage
# PCRE JIT allocates executable memory, which this unit intentionally forbids.
ExecStart=/usr/bin/php -d pcre.jit=0 /srv/canary/php.micutu.com/current/scripts/maintenance.php
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/canary/php.micutu.com/php_micutu_app_storage /srv/canary/php.micutu.com/sessions
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=yes
