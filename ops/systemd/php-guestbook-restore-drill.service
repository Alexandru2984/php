[Unit]
Description=Verify the newest PHP guestbook backup in an isolated restore drill
After=local-fs.target php-guestbook-backup.service
ConditionFileIsExecutable=/srv/canary/php.micutu.com/current/scripts/restore-drill.sh
OnFailure=swift-vapor-alert@%n.service
OnSuccess=swift-vapor-resolved@%n.service

[Service]
Type=oneshot
User=php-guestbook
Group=php-guestbook
UMask=0077
Environment=GUESTBOOK_BACKUP_DIR=/srv/backups/php-guestbook
Environment=GUESTBOOK_RESTORE_STATUS_FILE=/srv/backups/php-guestbook/restore-drill.last-success
Environment=GUESTBOOK_RESTORE_TMP_DIR=/run/php-guestbook-restore
Environment=GUESTBOOK_RESTORE_MAX_BACKUP_AGE_SECONDS=108000
Environment=GUESTBOOK_EXPECTED_MIGRATIONS=7
RuntimeDirectory=php-guestbook-restore
RuntimeDirectoryMode=0700
ExecStart=/srv/canary/php.micutu.com/current/scripts/restore-drill.sh
TimeoutStartSec=5min

NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/srv/backups/php-guestbook
InaccessiblePaths=/srv/canary/php.micutu.com/php_micutu_app_storage
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=yes
KeyringMode=private
LimitCORE=0
LimitNOFILE=128
TasksMax=16
MemoryMax=128M
CPUQuota=100%
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
